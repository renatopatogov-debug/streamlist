*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local credentials & secrets
cookies.txt
.env
*.pem
*.key

# Temporary backups & IDE tool artifacts
.zwork/
backup-*/
.pytest_cache/
.coverage
htmlcov/

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
